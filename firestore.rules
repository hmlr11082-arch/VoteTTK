rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Votes collection: public read and write so everyone's votes aggregate together in real time
    match /votes/{voteId} {
      allow read: if true;
      allow create: if request.resource.data.selectedCandidateIds.size() >= 1 &&
                       request.resource.data.selectedCandidateIds.size() <= 2 &&
                       (!exists(/databases/$(database)/documents/system/config) ||
                        !('lastResetAt' in get(/databases/$(database)/documents/system/config).data) ||
                        request.resource.data.timestamp >= get(/databases/$(database)/documents/system/config).data.lastResetAt);
      allow update, delete: if true;
    }

    // System configuration and reset synchronization
    match /system/{configId} {
      allow read: if true;
      allow write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
